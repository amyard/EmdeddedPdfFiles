ansparent 75%, rgb(255, 255, 255) 0px, rgb(255, 255, 255)); background-posi=
tion: 0px 0px, 30px 30px; background-size: 60px 60px; border: 1px dashed rg=
b(187, 187, 187); min-height: 100px; }

.angular-ui-tree-empty { pointer-events: none; }

.angular-ui-tree-nodes { list-style: none; margin: 0px; padding: 0px; posit=
ion: relative; }

.angular-ui-tree-nodes .angular-ui-tree-nodes { padding-left: 20px; }

.angular-ui-tree-node, .angular-ui-tree-placeholder { line-height: 20px; ma=
rgin: 0px; min-height: 20px; padding: 0px; position: relative; }

.angular-ui-tree-hidden { display: none; }

.angular-ui-tree-placeholder { margin: 10px; min-height: 30px; padding: 0px=
; }

.angular-ui-tree-handle { box-sizing: border-box; cursor: move; font-weight=
: 700; line-height: 20px; min-height: 20px; text-decoration: none; }

.angular-ui-tree-drag { opacity: 0.8; pointer-events: none; position: absol=
ute; z-index: 999; }

.angular-ui-tree-drag .tree-node-content { margin-top: 0px; }

